# NEVER commit the real .env (contains your Neo4j password).
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# For AuraDB Free, use: neo4j+s://<your-instance>.databases.neo4j.io
# For local Neo4j, use: bolt://127.0.0.1:7687
# Copy ONLY the Neo4j variables into your existing .env, preserving old settings.
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_PASSWORD
NEO4J_DATABASE=neo4j

# DL-K3: default Keras after training. For rollback: DL_MODEL_BACKEND=sklearn.
# GitHub clones DO NOT include model artifacts; train first (see README.md).
DL_MODEL_BACKEND=keras
MODEL_MANIFEST_PATH=config/model_manifest.json
EXPLANATION_MODE=template
AUDIT_DB_PATH=outputs/audit.sqlite3
