MERGE (f:Fact {id: 'f21'}) SET f.text = 'Người bệnh vẫn có thể ăn nhiều món quen thuộc; kế hoạch ăn uống nên được xây dựng linh hoạt theo sinh hoạt, sở thích và chỉ dẫn của nhân viên y tế.', f.topic_id = 'nutrition';
MATCH (t:Topic {id: 'nutrition'}), (f:Fact {id: 'f21'}) MERGE (t)-[:HAS_FACT]->(f);
