MERGE (f:Fact {id: 'f17'}) SET f.text = 'Bữa ăn cân bằng cho người mắc đái tháo đường có thể bao gồm rau củ không chứa nhiều tinh bột, các thực phẩm giàu đạm và nguồn tinh bột phù hợp; không có một thực đơn duy nhất cho tất cả mọi người.', f.topic_id = 'nutrition';
