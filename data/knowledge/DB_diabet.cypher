MERGE (f:Fact {id: 'f22'}) SET f.text = 'Nhu cầu ăn uống có thể thay đổi theo tình trạng sức khỏe, thuốc sử dụng và hoạt động hằng ngày; người mắc đái tháo đường nên thảo luận với nhân viên y tế hoặc chuyên gia dinh dưỡng để được tư vấn phù hợp.', f.topic_id = 'nutrition';
