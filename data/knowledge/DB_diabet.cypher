MERGE (f:Fact {id: 'f18'}) SET f.text = 'CDC giới thiệu cách hình dung đĩa ăn: khoảng một nửa là rau không chứa nhiều tinh bột, một phần tư là thực phẩm giàu đạm, phần còn lại là thực phẩm chứa carbohydrate.', f.topic_id = 'nutrition';
