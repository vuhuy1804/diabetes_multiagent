MERGE (f:Fact {id: 'f01'}) SET f.text = 'Đái tháo đường là tình trạng đường huyết tăng cao, việc đánh giá thực tế cần dựa trên xét nghiệm và nhân viên y tế.', f.topic_id = 'diabetes';
