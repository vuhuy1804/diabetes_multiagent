MERGE (f:Fact {id: 'f127'}) SET f.text = 'Việc lựa chọn thực phẩm, vận động, theo dõi sức khỏe và tái khám cần được cá nhân hóa cùng nhóm chăm sóc.', f.topic_id = 'daily_living';
MATCH (t:Topic {id: 'daily_living'}), (f:Fact {id: 'f127'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f127'}), (s:Source {id: 'cdc-living'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f128'}) SET f.text = 'Du lịch có thể làm thay đổi giờ ăn, mức vận động và múi giờ, từ đó ảnh hưởng đường huyết.', f.topic_id = 'travel_health';
MATCH (t:Topic {id: 'travel_health'}), (f:Fact {id: 'f128'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f128'}), (s:Source {id: 'cdc-travel'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f129'}) SET f.text = 'Thay đổi múi giờ trong chuyến đi có thể làm lịch sinh hoạt và bữa ăn khác thường; nên lên kế hoạch theo dõi sức khỏe phù hợp.', f.topic_id = 'travel_health';
MATCH (t:Topic {id: 'travel_health'}), (f:Fact {id: 'f129'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f129'}), (s:Source {id: 'cdc-travel'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f130'}) SET f.text = 'Dụng cụ theo dõi đường huyết nên được chuẩn bị để người bệnh có thể tiếp tục ghi nhận chỉ số khi đi xa.', f.topic_id = 'travel_health';
MATCH (t:Topic {id: 'travel_health'}), (f:Fact {id: 'f130'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f130'}), (s:Source {id: 'cdc-travel'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f131'}) SET f.text = 'Nhiệt độ khắc nghiệt có thể ảnh hưởng đến thiết bị theo dõi đường huyết, vì vậy nên kiểm tra hướng dẫn bảo quản thiết bị.', f.topic_id = 'travel_health';
MATCH (t:Topic {id: 'travel_health'}), (f:Fact {id: 'f131'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f131'}), (s:Source {id: 'cdc-travel'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f132'}) SET f.text = 'Đi bộ nhiều khi du lịch có thể làm bàn chân bị phồng rộp, vì vậy cần chú ý bảo vệ bàn chân.', f.topic_id = 'travel_health';
MATCH (t:Topic {id: 'travel_health'}), (f:Fact {id: 'f132'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f132'}), (s:Source {id: 'cdc-travel'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f133'}) SET f.text = 'Không phải mọi trường hợp tiểu đường đều giống nhau: type 1, type 2 và tiểu đường thai kỳ có cơ chế và cách quản lý khác nhau.', f.topic_id = 'misconceptions';
MATCH (t:Topic {id: 'misconceptions'}), (f:Fact {id: 'f133'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f133'}), (s:Source {id: 'niddk-types-what'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f134'}) SET f.text = 'Đái tháo đường type 2 có thể xuất hiện ở người trẻ, không chỉ ở người lớn tuổi.', f.topic_id = 'misconceptions';
MATCH (t:Topic {id: 'misconceptions'}), (f:Fact {id: 'f134'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f134'}), (s:Source {id: 'niddk-types-what'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f135'}) SET f.text = 'Đái tháo đường type 2 liên quan nhiều yếu tố, gồm di truyền, đề kháng insulin và các yếu tố sức khỏe khác; không thể quy cho riêng một món ăn.', f.topic_id = 'misconceptions';
MATCH (t:Topic {id: 'misconceptions'}), (f:Fact {id: 'f135'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f135'}), (s:Source {id: 'niddk-types-what'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f136'}) SET f.text = 'Kiểm soát đường huyết tốt không đồng nghĩa bệnh đã được chữa khỏi hoàn toàn; việc theo dõi vẫn cần theo hướng dẫn chuyên môn.', f.topic_id = 'misconceptions';
MATCH (t:Topic {id: 'misconceptions'}), (f:Fact {id: 'f136'}) MERGE (t)-[:HAS_FACT]->(f);
MATCH (f:Fact {id: 'f136'}), (s:Source {id: 'ada-remission-consensus'}) MERGE (f)-[:SUPPORTED_BY]->(s);
MERGE (f:Fact {id: 'f137'}) SET f.text = 'Đái tháo đường là rối loạn chuyển hóa liên quan insulin và glucose, không phải bệnh lây truyền qua tiếp xúc thông thường.', f.topic_id = 'misconceptions';
MATCH (t:Topic {id: 'misconceptions'}), (f:Fact {id: 'f137'}) MERGE (t)-[:HAS_FACT]->(f);
